PORT=3001
FRED_API_KEY=your_fred_api_key_here
DATABASE_PATH=./data/cache.db
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Token para POST /api/indices/:tipo/refresh (header x-admin-token). Sem ele, o refresh manual responde 503
# e os dados continuam sendo atualizados pela rotina diária e pela carga sob demanda.
ADMIN_TOKEN=
# 1 = aceitar só as origens de CORS_ORIGIN (inclua o domínio de produção do front antes de ligar)
CORS_STRICT=
